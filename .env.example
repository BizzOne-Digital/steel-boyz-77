# ---------- Required ----------
# MongoDB Atlas connection string (server-only, never prefix with NEXT_PUBLIC_)
MONGODB_URI=

# 32+ random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Public site URL, no trailing slash (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ---------- First admin (used only by `npm run create-admin`) ----------
# Remove ADMIN_SETUP_PASSWORD after the admin is created.
# Do not use "#" in values: .env treats it as a comment and cuts the value short.
ADMIN_SETUP_NAME=Scott Stephens
ADMIN_SETUP_EMAIL=
ADMIN_SETUP_PASSWORD=

# ---------- Optional: email notifications for new inquiries ----------
# If any SMTP value is missing, inquiries are still saved and shown in Admin, but no email is sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="STEEL BOYZ 7-7 Website <no-reply@example.com>"

# Fallback recipient if none is set in Admin > Site Settings > Inquiry notifications
CONTACT_NOTIFICATION_EMAIL=sdstephens321@gmail.com
